# ── Required ─────────────────────────────────────────────
# Public URL people use to reach the app (no trailing slash)
APP_URL=https://hr.example.com
AUTH_URL=https://hr.example.com
# Random secret: openssl rand -base64 32
AUTH_SECRET=change-me
POSTGRES_PASSWORD=change-me-too

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorised redirect URI: ${APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Who becomes ADMIN on their first Google sign-in (comma-separated)
ADMIN_EMAILS=you@yourcompany.com

# ── Access ───────────────────────────────────────────────
# Domains whose users may self-register as EMPLOYEE on first sign-in.
# Leave empty for invite-only (admins add people under Admin → Employees).
ALLOWED_EMAIL_DOMAINS=

# ── Optional ─────────────────────────────────────────────
APP_NAME=OpenHR
CURRENCY=MYR
TZ_DISPLAY=Asia/Kuala_Lumpur
# ISO weekdays that count as working days (1=Mon … 7=Sun). Kedah/Kelantan/Terengganu: 7,1,2,3,4
WORKING_DAYS=1,2,3,4,5
APP_PORT=3000

# Email notifications (approvals, decisions, invites). Leave SMTP_HOST empty to just log them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OpenHR <hr@yourcompany.com>

# Evaluation only: password-less login as any existing user. NEVER enable in production.
DEMO_LOGIN=false
